<Window x:Class="BetterHwMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Better HW Monitor" Height="850" Width="1500"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}"
        SourceInitialized="Window_SourceInitialized"
        Closing="Window_Closing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SensorColumn" Width="520" MinWidth="260" />
            <ColumnDefinition x:Name="SplitterColumn" Width="5" />
            <ColumnDefinition Width="*" MinWidth="300" />
        </Grid.ColumnDefinitions>

        <!-- Sensor list -->
        <DockPanel x:Name="SensorPanel" Grid.Column="0">
            <DockPanel DockPanel.Dock="Top" Margin="6">
                <Button DockPanel.Dock="Right" Content="◀ Hide" Margin="6,0,0,0" Padding="8,2"
                        ToolTip="Hide the sensor list to give the graphs more room"
                        Click="HideSensors_Click" />
                <Button DockPanel.Dock="Right" Content="Reset Min/Max" Margin="6,0,0,0" Padding="8,2"
                        Click="ResetMinMax_Click" />
                <TextBlock DockPanel.Dock="Left" Text="Filter:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox x:Name="SearchBox" VerticalContentAlignment="Center"
                         ToolTip="Filter by sensor name, device or type (e.g. 'temp', 'GPU', 'Fan')"
                         TextChanged="SearchBox_TextChanged" />
            </DockPanel>
            <TextBlock DockPanel.Dock="Bottom" Margin="6,4" Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap"
                       Text="Double-click a sensor to add it to the selected graph, or drag sensors onto any graph. Ctrl/Shift-click to pick several." />
            <ListView x:Name="SensorList"
                      SelectionMode="Extended"
                      VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      MouseDoubleClick="SensorList_MouseDoubleClick"
                      PreviewMouseLeftButtonDown="SensorList_PreviewMouseLeftButtonDown"
                      PreviewMouseMove="SensorList_PreviewMouseMove">
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Add to selected graph" Click="AddToActive_Click" />
                        <MenuItem Header="Add to a new graph" Click="AddToNew_Click" />
                    </ContextMenu>
                </ListView.ContextMenu>
                <ListView.GroupStyle>
                    <GroupStyle>
                        <!-- Each category (e.g. "Embedded Controller") has a clickable header that collapses it -->
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="GroupItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="GroupItem">
                                            <StackPanel>
                                                <ToggleButton x:Name="GroupToggle" IsChecked="True" Focusable="False" Cursor="Hand"
                                                              ToolTip="Click to collapse / expand this category"
                                                              Loaded="GroupToggle_Loaded"
                                                              DataContextChanged="GroupToggle_DataContextChanged"
                                                              Checked="GroupToggle_Changed" Unchecked="GroupToggle_Changed">
                                                    <ToggleButton.Template>
                                                        <ControlTemplate TargetType="ToggleButton">
                                                            <Border Background="Transparent" Padding="2,8,0,2">
                                                                <ContentPresenter />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </ToggleButton.Template>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock x:Name="GroupArrow" Text="▾" Width="14"
                                                                   Foreground="{DynamicResource HeaderTextBrush}" />
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold"
                                                                   Foreground="{DynamicResource HeaderTextBrush}" />
                                                        <TextBlock Text="{Binding ItemCount, StringFormat=' ({0})'}"
                                                                   Foreground="{DynamicResource SubtleTextBrush}" />
                                                    </StackPanel>
                                                </ToggleButton>
                                                <ItemsPresenter x:Name="GroupItems" />
                                            </StackPanel>
                                            <ControlTemplate.Triggers>
                                                <Trigger SourceName="GroupToggle" Property="IsChecked" Value="False">
                                                    <Setter TargetName="GroupItems" Property="Visibility" Value="Collapsed" />
                                                    <Setter TargetName="GroupArrow" Property="Text" Value="▸" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </ListView.GroupStyle>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Sensor" Width="230" DisplayMemberBinding="{Binding Name}" />
                        <GridViewColumn Header="Current" Width="90" DisplayMemberBinding="{Binding ValueText}" />
                        <GridViewColumn Header="Min" Width="85" DisplayMemberBinding="{Binding MinText}" />
                        <GridViewColumn Header="Max" Width="85" DisplayMemberBinding="{Binding MaxText}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </DockPanel>

        <GridSplitter x:Name="Splitter" Grid.Column="1" HorizontalAlignment="Stretch" />

        <!-- Graphs -->
        <DockPanel Grid.Column="2" Background="{DynamicResource GraphAreaBrush}">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6">
                <Button x:Name="ShowSensorsButton" Content="Sensors ▶" Padding="10,2" Margin="0,0,8,0"
                        Visibility="Collapsed" ToolTip="Show the sensor list again" Click="ShowSensors_Click" />
                <Button Content="+ New graph" Padding="10,2" Click="NewGraph_Click" />
                <TextBlock Text="Time window:" VerticalAlignment="Center" Margin="16,0,4,0" />
                <ComboBox x:Name="WindowCombo" Width="95" SelectionChanged="WindowCombo_SelectionChanged" />
                <TextBlock Text="Update every:" VerticalAlignment="Center" Margin="16,0,4,0" />
                <ComboBox x:Name="IntervalCombo" Width="80" SelectionChanged="IntervalCombo_SelectionChanged" />
                <Button x:Name="ThemeButton" Margin="16,0,0,0" Padding="10,2" Click="ThemeButton_Click" />
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="16,0,0,0"
                           Foreground="{DynamicResource SubtleTextBrush}" />
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="GraphsHost" Margin="4,0,4,4" />
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
